# Copy to .env and change every value marked CHANGE. Never commit .env.
# Use long random alphanumeric passwords, e.g.:  openssl rand -hex 24

POSTGRES_PASSWORD=CHANGE-to-a-long-random-value
APP_DB_PASSWORD=CHANGE-to-a-different-long-random-value

# Host port the web interface is published on
HTTP_PORT=8081

# The URL users reach PLM at. Encoded into QR labels, so set it before printing labels.
PUBLIC_BASE_URL=http://localhost:8081

# Set to true when PLM is served over HTTPS (required for production use; see docs/deployment.md)
COOKIE_SECURE=false

# production | development  (demo data can only be loaded when development)
PLM_ENVIRONMENT=production

SESSION_IDLE_MINUTES=30
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
PLM_VERSION=0.3.1
